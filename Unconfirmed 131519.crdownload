def vacuum_cleaner(room_A, room_B, position):
    if position == "A":

        if room_A == "Dirty":
            print("\nRoom A is dirty.")
            print("Cleaning Room A...")
            room_A = "Clean"

        position = "B"

    if position == "B":
        if room_B == "Dirty":
            print("Room B is dirty.")
            print("Cleaning Room B...")
            room_B = "Clean"

vacuum_cleaner("Dirty", "Dirty", "A")